@model IEnumerable<WebBanGiay.Models.Order>
@{
    ViewBag.Title = "Quản lý đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-receipt"></i> Danh sách đơn hàng</h3>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>#@item.OrderId</strong></td>
                <td>
                    <div>@item.CustomerName</div>
                    <small class="text-muted">@item.CustomerPhone</small>
                </td>
                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="fw-bold text-danger">@item.TotalAmount.ToString("N0") ₫</td>
                <td>
                    @if (item.Status == "Chờ xử lý")
                    {<span class="badge bg-warning text-dark">Chờ xử lý</span> }
                    else if (item.Status == "Đang giao")
                    { <span class="badge bg-info">Đang giao</span> }
                    else if (item.Status == "Hoàn thành")
                    { <span class="badge bg-success">Hoàn thành</span> }
                    else
                    { <span class="badge bg-danger">@item.Status</span>}
                </td>
                <td>
                    <a href="@Url.Action("Details", new { id = item.OrderId })" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i> Chi tiết
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>